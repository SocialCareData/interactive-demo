    {
      "@type": "CareAssessmentQuestion",
      "category": "PersonalContext",
      "questionText": "Pen picture: what matters to Margaret",
      "answer": [
        "Margaret has lived in Orchard Cottages for 51 years and wants to stay there. She was a primary school secretary and still knows half of Eastfield by name. She loves her garden, Radio 4 and her cat, Biscuit. Her Sunday lunches with Sarah and the grandchildren matter more to her than anything. She hates fuss and would rather 'manage with a bit of help' than go into a home."
      ],
      "answerType": "String",
      "required": false
