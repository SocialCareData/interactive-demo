      "value": "SVC-CFD"
    }
  ],
  "assessmentQuestion": [
    {
      "@type": "ReferralAssessmentQuestion",
      "category": "SUBJECT.VOICE_WISHES",
      "questionText": "What has the child said about what is happening, and what they would like to happen?",
      "answer": [
        "Riley told his teacher he is 'always hungry in the mornings' and asked if he could take toast home for Mia. He said Mum is 'tired a lot' and he gets Mia ready for nursery. He said he likes school and does not want to get Mum in trouble."
      ],
      "answerType": "String",
      "required": false
    }
