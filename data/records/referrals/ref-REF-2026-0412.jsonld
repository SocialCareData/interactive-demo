  "concern": [
    {
      "@type": "ConcernDetail",
      "concernType": "child.neglect",
      "description": "Riley has come into school hungry most mornings since the start of term. He has asked staff for food at breakfast club on 8 of the last 10 days and has been seen taking leftover toast in his bag. His uniform is often unwashed and he has worn the same jumper all week. He has missed 6 days since 3 September with no reason given. On Friday 11 September nobody collected him or his sister from nursery until 5.15pm; we could not reach Mum by phone. Riley said Mum was 'asleep'."
    }
  ],
  "recipient": [
    {
      "@type": "Identifier",
